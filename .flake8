[flake8]
max-line-length = 120
extend-ignore = E203, F401, E402, E501, W503
exclude = .git,__pycache__,build,dist,*.egg-info,backend/tests
per-file-ignores =
    # Allow unused imports in __init__.py files
    __init__.py: F401
    # Allow module level imports not at top of file
    */routes/*.py: E402
    # Allow long lines in specific files
    */config/*.py: E501
