# Environment and API Settings
ENVIRONMENT=development
PROJECT_NAME="Recipe Database API"
API_V1_STR=/api/v1
VERSION=0.1.0

# Security
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days
ALGORITHM=HS256

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=recipe_db
# Optional: Override full DATABASE_URL
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Recipe API Keys
SPOONACULAR_API_KEY=your_spoonacular_key
EDAMAM_APP_ID=your_edamam_id
EDAMAM_APP_KEY=your_edamam_key
API_NINJAS_API_KEY=your_api_ninjas_key
TASTY_API_KEY=your_tasty_key

# API Rate Limits
SPOONACULAR_POINTS_PER_DAY=150
SPOONACULAR_REQUESTS_PER_MINUTE=10
EDAMAM_REQUESTS_PER_MINUTE=10
API_NINJAS_REQUESTS_PER_MINUTE=10
TASTY_REQUESTS_PER_MINUTE=10

# Cache Settings
REDIS_URL=redis://localhost
CACHE_TTL=3600

# Service Configuration
MAX_CONCURRENT_REQUESTS=5
LOG_LEVEL=INFO  # Use DEBUG for development
LOG_FORMAT=json  # json or text
LOG_FILE=logs/recipe_service.log
MOCK_RESPONSES=false
MOCK_DELAY=0
DEFAULT_RECIPE_PROVIDER=spoonacular

# User Management
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin
