# API Settings
PROJECT_NAME="Recipe Database API"
API_V1_STR=/api/v1

# Security
SECRET_KEY=dev_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recipe_db

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Recipe APIs
SPOONACULAR_API_KEY=dev_spoonacular_key
EDAMAM_APP_ID=dev_edamam_id
EDAMAM_APP_KEY=dev_edamam_key
API_NINJAS_API_KEY=dev_api_ninjas_key
TASTY_API_KEY=dev_tasty_key

# Rate Limiting
SPOONACULAR_POINTS_PER_DAY=150
SPOONACULAR_REQUESTS_PER_MINUTE=10
EDAMAM_REQUESTS_PER_MINUTE=10
API_NINJAS_REQUESTS_PER_MINUTE=10
TASTY_REQUESTS_PER_MINUTE=10

# Cache and Redis
REDIS_URL=redis://localhost
CACHE_TTL=3600

# Service Configuration
MAX_CONCURRENT_REQUESTS=5
LOG_LEVEL=DEBUG  # More verbose logging in development
LOG_FORMAT=json
LOG_FILE=logs/recipe_service.log

# Development Settings
MOCK_RESPONSES=true
MOCK_DELAY=0

# User Management
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin
