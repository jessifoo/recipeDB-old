# FAST Environment
FASTAPI_ENV=development  # Set to 'production' in production environment
FASTAPI_APP=app.main

# API Keys
SPOONACULAR_API_KEY=your-api-key-here
EDAMAM_APP_ID=your_edamam_app_id_here
EDAMAM_APP_KEY=your_edamam_app_key_here
API_NINJAS_API_KEY=your_api_ninjas_key_here
TASTY_API_KEY=your_tasty_rapidapi_key_here

# Service Configuration
CACHE_TTL=3600  # Cache time-to-live in seconds
MAX_CONCURRENT_REQUESTS=5  # Maximum number of concurrent API requests

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text
LOG_FILE=logs/recipe_service.log  # Log file path (relative to backend directory)

# Rate Limiting
SPOONACULAR_POINTS_PER_DAY=150
SPOONACULAR_REQUESTS_PER_MINUTE=10
EDAMAM_REQUESTS_PER_MINUTE=10
API_NINJAS_REQUESTS_PER_MINUTE=10
TASTY_REQUESTS_PER_MINUTE=10

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recipe_db

# Redis Configuration
REDIS_URL="redis://localhost"

# Development Settings
MOCK_RESPONSES=false  # Set to true to use mock responses instead of real API calls
MOCK_DELAY=0  # Artificial delay for mock responses in seconds

# API Settings
PROJECT_NAME="Recipe Database API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY=your-secret-key-here  # Change this in production
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password  # Change this in production
POSTGRES_DB=recipe_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Email
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=Recipe DB

# First Superuser
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin  # Change this in production
